# /etc/delve/env — root:delve 0640. Never commit the real file.

# PostgreSQL over the unix socket, peer auth (OS user `delve` = role `delve`).
DELVE_DATABASE_URL=postgresql+asyncpg:///delve?host=/run/postgresql
DELVE_DB_CONNECT_TIMEOUT_S=3

# Hermes API server.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=<copy API_SERVER_KEY from the agent user's ~/.hermes/.env>
HERMES_EXPECTED_VERSION=0.22.2
# Per-run thinking route: must match a custom_providers entry with a base_url that
# differs from the default provider's (see delve-infra hermes/config.fragments.yaml).
HERMES_THINK_PROVIDER=custom:llama-qwen38-think
HERMES_THINK_MODEL=/home/<operator>/models/qwen38/Qwen3.8-27B-UD-IQ4_XS.gguf
# Must equal approvals.timeout in the Hermes config.
HERMES_APPROVAL_TIMEOUT_S=300

LLAMA_BASE_URL=http://127.0.0.1:8080

# Push (FCM HTTP v1). Leave FCM_SERVICE_ACCOUNT_FILE unset to turn pushing off.
# The key: Firebase console -> Project settings -> Service accounts (root:delve 0640).
FCM_SERVICE_ACCOUNT_FILE=/etc/delve/fcm.json
# Defaults to the key's project_id.
#FCM_PROJECT_ID=
# "Run finished" only for runs at least this long (seconds); scheduled runs always.
PUSH_RUN_DONE_MIN_S=20

# The agent's cards, read-only through the delve-infra drop-in cards.conf.
DELVE_CARDS_PATH=/run/delve/cards/events.jsonl
DELVE_CARDS_POLL_S=2

# Attachments: images in the state directory, files in the inbox the agent reads
# (2750 delve:agent, delve-infra), both deleted after the retention (days).
DELVE_INBOX_DIR=/var/lib/delve-inbox
DELVE_ATTACHMENTS_DIR=/var/lib/delve/attachments
DELVE_ATTACHMENT_RETENTION_DAYS=14

# The privileged helper (delve-infra: bin/delve-helper, delve-helper.socket).
DELVE_HELPER_SOCKET=/run/delve-helper.sock
# How long a started llama-server may load before queued runs are let go anyway (seconds).
DELVE_LLAMA_START_WAIT_S=180

# Schedules (the morning brief is one of them; its time is set in the app).
DELVE_SCHEDULE_TICK_S=30
# A firing later than this (the backend was down) is skipped instead of caught up (seconds).
DELVE_SCHEDULE_CATCHUP_S=3600

# Observability: GPU samples every N seconds (0: off), and how long samples and the
# push log are kept (days).
DELVE_STATS_SAMPLE_S=60
DELVE_GPU_RETENTION_DAYS=30
DELVE_PUSH_LOG_RETENTION_DAYS=90

# Watchers: how often the agent's cron jobs are read through the helper (seconds, 0: only
# on demand), the judge's llama call limit (seconds), how long hits and the rest are kept.
DELVE_WATCH_RECONCILE_S=300
DELVE_WATCH_JUDGE_TIMEOUT_S=90
DELVE_WATCH_HIT_RETENTION_DAYS=180
DELVE_WATCH_REJECT_RETENTION_DAYS=30

DELVE_BIND=127.0.0.1:8700
DELVE_LOG_LEVEL=INFO
